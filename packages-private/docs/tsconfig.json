{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@cesiumlab/effects": ["../../packages/effects/src/index.ts"],
      "@docs/*": ["./src/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "@astryxdesign/core": ["./node_modules/@astryxdesign/core/dist/index.d.ts"],
      "lucide-react": ["./node_modules/lucide-react/dist/lucide-react.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/*/src/**/demos/**/*"]
}
