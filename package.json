{
  "name": "cesiumlab",
  "version": "0.0.0",
  "private": true,
  "description": "Visual-first CesiumJS experiments and reusable modules.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=12.8.1 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @cesiumlab/playground dev",
    "build": "pnpm --filter @cesiumlab/playground build",
    "build:base": "pnpm --filter @cesiumlab/playground build:base",
    "preview": "pnpm --filter @cesiumlab/playground preview",
    "preview:base": "pnpm --filter @cesiumlab/playground preview:base",
    "typecheck": "pnpm --filter @cesiumlab/playground typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @cesiumlab/playground test",
    "test:e2e": "pnpm --filter @cesiumlab/playground test:e2e",
    "test:e2e:base": "pnpm --filter @cesiumlab/playground test:e2e:base",
    "test:e2e:dev": "pnpm --filter @cesiumlab/playground test:e2e:dev",
    "test:e2e:stage2": "pnpm --filter @cesiumlab/playground test:e2e:stage2",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "cesium": "catalog:",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1"
  }
}
